                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/rest/flickr.photos.search?api_key=<string>&text=<string>&tags=<string>&tag_mode=all&license=<string>&media=all&user_id=<string>&page=1&per_page=100&extras=<string>",
