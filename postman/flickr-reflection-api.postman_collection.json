        {
          "name": "Invoke Any Flickr Method",
          "id": "ffaa7bbe-da3a-4a44-855b-ae2cd89c6660",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest?method=<string>&api_key=<string>&format=json&nojsoncallback=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rest"
              ],
              "query": [
                {
                  "description": "(Required) Fully qualified flickr method, e.g. `flickr.photos.search`.",
                  "key": "method",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Application API key.",
                  "key": "api_key",
                  "value": "<string>"
                },
                {
                  "description": "Response format (json/xml/php_serial/rest).",
                  "key": "format",
                  "value": "json"
                },
                {
                  "description": "Set to 1 to receive raw JSON instead of JSONP.",
                  "key": "nojsoncallback",
                  "value": "1"
                }
              ]
            },
            "description": "Dispatches a call to any flickr.* method. The `method` query parameter\nselects which method to invoke and the remaining query parameters are\nthe arguments for that method. This single endpoint backs every\nper-method operation defined below.\n"
          },
          "response": [
            {
              "id": "a75188c1-01c5-4d2d-ad6d-a4b6a5d498e9",
              "name": "Method response (shape depends on method)",
