          "item": [
            {
              "name": "Get A User's Favorites",
              "id": "117ee8f4-d553-48f3-a8d0-a114ee35849c",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/rest/flickr.favorites.getList?api_key=<string>&user_id=<string>&page=1&per_page=100",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "rest",
                    "flickr.favorites.getList"
                  ],
                  "query": [
                    {
                      "description": "(Required) Application API key.",
                      "key": "api_key",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) ",
                      "key": "user_id",
                      "value": "<string>"
                    },
                    {
                      "key": "page",
                      "value": "1"
                    },
                    {
                      "key": "per_page",
                      "value": "100"
                    }
                  ]
                },
                "description": "Returns a list of the user's favorite photos. Only photos which the calling user has permission to see are returned."
              },
