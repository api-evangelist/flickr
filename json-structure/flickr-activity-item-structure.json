{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-structure/flickr-activity-item-structure.json",
  "name": "ActivityItem",
  "description": "ActivityItem schema from Flickr API",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "example": "photo"
    },
    "id": {
      "type": "string",
      "example": "52345678901"
    },
    "owner": {
      "type": "string",
      "example": "12345678@N00"
    },
    "secret": {
      "type": "string",
      "example": "abc1234def"
    },
    "server": {
      "type": "string",
      "example": "65535"
    },
    "farm": {
      "type": "int32",
      "example": 66
    },
    "name": {
      "type": "string",
      "example": "Golden Gate Sunset"
    }
  }
}