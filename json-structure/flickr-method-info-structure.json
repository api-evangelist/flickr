{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-structure/flickr-method-info-structure.json",
  "name": "MethodInfo",
  "description": "MethodInfo schema from Flickr API",
  "type": "object",
  "properties": {
    "method": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Bay Area Photographers"
        },
        "needslogin": {
          "type": "int32",
          "example": 0
        },
        "needssigning": {
          "type": "int32",
          "example": 1
        },
        "requiredperms": {
          "type": "int32",
          "example": 0
        },
        "description": {
          "type": "object",
          "properties": {
            "_content": {
              "type": "string",
              "example": "100"
            }
          }
        }
      }
    },
    "arguments": {
      "type": "object",
      "properties": {
        "argument": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "Bay Area Photographers"
              },
              "optional": {
                "type": "int32",
                "example": 0
              },
              "_content": {
                "type": "string",
                "example": "100"
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "properties": {
        "error": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "int32",
                "example": 100
              },
              "message": {
                "type": "string",
                "example": "Invalid API Key"
              },
              "_content": {
                "type": "string",
                "example": "100"
              }
            }
          }
        }
      }
    }
  }
}