{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-structure/flickr-brand-list-structure.json",
  "name": "BrandList",
  "description": "BrandList schema from Flickr API",
  "type": "object",
  "properties": {
    "brand": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "52345678901"
          },
          "name": {
            "type": "string",
            "example": "Bay Area Photographers"
          }
        }
      }
    }
  }
}