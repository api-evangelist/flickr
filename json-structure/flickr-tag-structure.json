{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-structure/flickr-tag-structure.json",
  "name": "Tag",
  "description": "Tag schema from Flickr API",
  "type": "object",
  "properties": {
    "_content": {
      "type": "string",
      "example": "100"
    },
    "score": {
      "type": "int32",
      "example": 87
    },
    "thm_data": {
      "type": "object",
      "additionalProperties": true,
      "example": {}
    }
  }
}