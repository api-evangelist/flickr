{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-structure/flickr-photoset-list-structure.json",
  "name": "PhotosetList",
  "description": "PhotosetList schema from Flickr API",
  "type": "object",
  "properties": {
    "page": {
      "type": "int32",
      "example": 1
    },
    "pages": {
      "type": "int32",
      "example": 12
    },
    "perpage": {
      "type": "int32",
      "example": 100
    },
    "total": {
      "type": "int32",
      "example": 1183
    },
    "photoset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "52345678901"
          },
          "primary": {
            "type": "string",
            "example": "52345678901"
          },
          "owner": {
            "type": "string",
            "example": "12345678@N00"
          },
          "name": {
            "type": "object",
            "properties": {
              "_content": {
                "type": "string",
                "example": "100"
              }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "_content": {
                "type": "string",
                "example": "100"
              }
            }
          },
          "photos": {
            "type": "int32",
            "example": 248
          },
          "videos": {
            "type": "int32",
            "example": 3
          }
        }
      }
    }
  }
}