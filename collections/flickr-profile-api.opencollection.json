{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flickr Activity Profile API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get A User Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flickr.com/services/rest/flickr.profile.getProfile",
            "params": [
              {
                "name": "api_key",
                "value": "ab1234567890cdef1234567890abcd12",
                "type": "query",
                "description": "Application API key."
              },
              {
                "name": "user_id",
                "value": "12345678@N00",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the public profile fields for a user."
        }
      ]
    }
  ],
  "bundled": true
}