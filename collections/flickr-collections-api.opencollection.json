{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flickr Activity Collections API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get The Collection Tree",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flickr.com/services/rest/flickr.collections.getTree",
            "params": [
              {
                "name": "api_key",
                "value": "ab1234567890cdef1234567890abcd12",
                "type": "query",
                "description": "Application API key."
              },
              {
                "name": "collection_id",
                "value": "12345678-72157712345",
                "type": "query"
              },
              {
                "name": "user_id",
                "value": "12345678@N00",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a tree (or sub-tree) of collections belonging to a user."
        }
      ]
    }
  ],
  "bundled": true
}