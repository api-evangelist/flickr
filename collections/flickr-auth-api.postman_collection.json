          "request": {
            "name": "Check OAuth Token",
            "description": {
              "content": "Returns the credentials attached to an OAuth authentication token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "flickr.auth.oauth.checkToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Application API key."
                },
                {
                  "disabled": false,
                  "key": "oauth_token",
                  "value": "<string>",
                  "description": "(Required) The OAuth authentication token to check."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
