{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flickr Activity Prefs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Prefs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Default Privacy Preference",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flickr.com/services/rest/flickr.prefs.getPrivacy",
            "params": [
              {
                "name": "api_key",
                "value": "ab1234567890cdef1234567890abcd12",
                "type": "query",
                "description": "Application API key."
              }
            ]
          },
          "docs": "Returns the default privacy level preference for the calling user."
        }
      ]
    }
  ],
  "bundled": true
}