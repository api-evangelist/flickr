        {
          "id": "fade6081-056f-4682-b12f-d088e5952b78",
          "name": "Invoke Any Flickr Method",
          "request": {
            "name": "Invoke Any Flickr Method",
            "description": {
              "content": "Dispatches a call to any flickr.* method. The `method` query parameter\nselects which method to invoke and the remaining query parameters are\nthe arguments for that method. This single endpoint backs every\nper-method operation defined below.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "method",
                  "value": "<string>",
                  "description": "(Required) Fully qualified flickr method, e.g. `flickr.photos.search`."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Application API key."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format (json/xml/php_serial/rest)."
                },
                {
                  "disabled": false,
                  "key": "nojsoncallback",
                  "value": "1",
                  "description": "Set to 1 to receive raw JSON instead of JSONP."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
