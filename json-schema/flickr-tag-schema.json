{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-schema/flickr-tag-schema.json",
  "title": "Tag",
  "description": "Tag schema from Flickr API",
  "type": "object",
  "properties": {
    "_content": {
      "type": "string",
      "example": "100"
    },
    "score": {
      "type": "integer",
      "example": 87
    },
    "thm_data": {
      "type": "object",
      "additionalProperties": true,
      "example": {}
    }
  }
}