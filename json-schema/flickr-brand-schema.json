{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-schema/flickr-brand-schema.json",
  "title": "Brand",
  "description": "Brand schema from Flickr API",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "52345678901"
    },
    "name": {
      "type": "string",
      "example": "Bay Area Photographers"
    }
  }
}