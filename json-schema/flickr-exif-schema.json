{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-schema/flickr-exif-schema.json",
  "title": "Exif",
  "description": "Exif schema from Flickr API",
  "type": "object",
  "properties": {
    "tagspace": {
      "type": "string",
      "example": "EXIF"
    },
    "tagspaceid": {
      "type": "integer",
      "example": 0
    },
    "tag": {
      "type": "string",
      "example": "ISO"
    },
    "label": {
      "type": "string",
      "example": "Original"
    },
    "raw": {
      "type": "object",
      "properties": {
        "_content": {
          "type": "string",
          "example": "100"
        }
      }
    }
  }
}