{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/flickr/refs/heads/main/json-schema/flickr-license-schema.json",
  "title": "License",
  "description": "License schema from Flickr API",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "example": "52345678901"
    },
    "name": {
      "type": "string",
      "example": "Bay Area Photographers"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "example": "https://www.flickr.com/galleries/12345678@N00/72157712345/"
    }
  }
}